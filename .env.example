# Copy to .env for local development overrides.
# Never commit .env — it may contain machine-specific paths.

# Override the default data directory. macOS uses
# ~/Library/Application Support/margins; iOS uses its iCloud Documents
# container, or local Documents/Library at runtime.
# MARGINS_DATA_DIR=/path/to/margins/app-data

# Optional: point at a synced/cloud library root instead of the default data dir.
# Useful when your EPUB library lives on an external drive or self-hosted sync folder.
# MARGINS_LIBRARY_ROOT=/Volumes/Books/margins-library
