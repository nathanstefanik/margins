# Build output
target/
/build/
apple/.build/

# iOS signing (local team ID — never committed)
apple/ios/Signing.local.xcconfig

# Xcode user state (regenerated on open; never commit)
xcuserdata/
*.xcuserstate
apple/.swiftpm/
apple/ios/Margins.xcodeproj/project.xcworkspace/

# Generated UniFFI bindings (regenerate with make core)
apple/Sources/margins_ffiFFI/include/
apple/Sources/MarginsCore/Generated/

# Release artifacts (build/Margins.app, DMGs from the release flow)
*.dmg

# Icon build intermediates (regenerate with scripts/make-icon.swift)
scripts/assets/Margins.iconset/

# Environment and secrets
.env
.env.*
!.env.example

# Logs
*.log

# Editor
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
.TemporaryItems
*.icloud

# Operator-local agent tooling (do not vendor)
.agents/
.claude/
.codex/
.cursor/
opencode.json
skills-lock.json
