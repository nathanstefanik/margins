# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
.TemporaryItems
*.icloud

# Local development plans
*-plan.md

# Xcode user state and build byproducts
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside
DerivedData/
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
*.xcresult
*.xcarchive/

# SwiftPM build/cache state. Shared package resolution is tracked
# (apple/Package.resolved and the iOS project's xcshareddata copy) so
# builds are reproducible for everyone.
.build/
.swiftpm/
__pycache__/
*.py[cod]

# Local build output
/build/
*.dmg

# Local signing (team ID — never commit)
apple/ios/Signing.local.xcconfig
*.provisionprofile
*.mobileprovision
*.p8
*.p12
*.keychain-db
*.keychain-db-*
*.local.plist
*[eE]xport*ptions*.plist

# Release artifacts (keep local — never commit)
*.pkg

# Regeneration intermediates (scripts/make-icon.swift)
scripts/assets/Margins.iconset/

# Environment and secrets
.env
.env.*
!.env.example

# Logs
*.log

# Editor
.idea/
.vscode/
*.swp
*.swo

# Operator-local agent tooling (do not vendor). Shared skills under
# .agents/skills/ ARE vendored; keep machine-local skills in *-local/ dirs.
.agents/*
!.agents/skills/
.agents/skills/*-local/
.claude/
.codex/
.cursor/
opencode.json
skills-lock.json
.devin/*.local.json
.devin/rules/*.local.md
.devin/skills/*-local/
