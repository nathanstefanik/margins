# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
.TemporaryItems
*.icloud

# Xcode user state and build byproducts
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside
DerivedData/
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
*.xcresult

# SwiftPM build/cache state. Shared package resolution is tracked
# (apple/Package.resolved and the iOS project's xcshareddata copy) so
# builds are reproducible for everyone.
.build/
.swiftpm/

# Local build output
/build/
*.dmg

# Rust build directory. The core left Rust behind, but stale working
# trees and old checkouts may still hold one — never let it come back.
target/

# Local signing (team ID — never commit)
apple/ios/Signing.local.xcconfig

# Regeneration intermediates (scripts/make-icon.swift)
scripts/assets/Margins.iconset/

# Environment and secrets
.env
.env.*
!.env.example

# Logs
*.log

# Editor
.idea/
*.swp
*.swo

# Operator-local agent tooling (do not vendor)
.agents/
.claude/
.codex/
.cursor/
opencode.json
skills-lock.json
